# Copy this file to .env.local and fill in your values.
# Never commit .env.local to GitHub.

# Google AI Studio -> Get API key (one key per team)
GEMINI_API_KEY=

# Gemini model name. Use the model your trainer gives you.
# (2.5 models are no longer available to new API keys.)
GEMINI_MODEL=gemini-3.5-flash-lite

# Supabase -> Project Settings -> Project URL
SUPABASE_URL=

# Supabase -> Project Settings -> API Keys -> secret key (starts with sb_secret_)
# Server only. Never use this in frontend code. The publishable key will NOT work.
SUPABASE_SECRET_KEY=

# Your team's passcode. It protects your app and your Gemini quota.
APP_PASSCODE=
